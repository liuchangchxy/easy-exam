# ==============================================================================
# EasyExam (易考宝) 环境变量配置模板
# 使用方式: 复制本文件为 .env 并填入实际值 (cp .env.example .env)
# ==============================================================================

# 【必填】敏感凭证加密主密钥 (用于对称加密存储用户配置的 AI / 搜索 API Key)
# 生成方式: openssl rand -hex 32 或 python -c "import secrets; print(secrets.token_hex(32))"
# 注意: 容器升级或重建时请务必保持此密钥不变，否则已加密的历史凭据无法解密！
EASYEXAM_SECRET_KEY=replace-with-your-strong-random-key-at-least-32-chars

# 服务端口 (默认 3000)
PORT=3000

# 数据持久化目录 (默认 /app/data)
DATA_DIR=/app/data

# 默认本地 Ollama / 大模型 API 端点 (可选)
LLM_BASE_URL=http://host.docker.internal:11434/v1
