{
  "name": "fn-exam-frontend",
  "version": "1.0.16",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/exam.test.js tests/sync.test.js tests/practice.test.js tests/theme.test.js tests/locale.test.js",
    "test:unit": "npm run check:localization && node --test tests/exam.test.js tests/sync.test.js tests/practice.test.js tests/theme.test.js tests/locale.test.js",
    "check:localization": "node scripts/check_localization_config.js && node scripts/scan_localized_templates.js",
    "check:localization:catalog": "node --test tests/locale.test.js",
    "test:e2e": "node tests/browser_e2e.test.js",
    "test:localization:e2e": "node tests/localization_e2e.test.js"
  },
  "dependencies": {
    "vue": "^3.4.21",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.4",
    "playwright": "^1.63.0",
    "vite": "^5.1.6"
  }
}
